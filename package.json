{
  "name": "crepuscular-archipelago",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "content": "node scripts/content.mjs",
    "build": "npm run content && tsc -b && vite build && node scripts/pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "d3-contour": "^4.0.2",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simplex-noise": "^4.0.3",
    "smol-toml": "^1.4.2",
    "tailwindcss": "^4.1.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/d3-contour": "^3.0.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
